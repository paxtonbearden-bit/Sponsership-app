# Copy to .env.local for local work; set the same names in Vercel for the live site.
# NEVER commit real values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=

# Public site address (used in emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
